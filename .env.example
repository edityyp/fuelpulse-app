# PRIVATE server settings. Never use VITE_ for secrets.
DATABASE_URL=
MIGRATION_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
# Optional 32-byte base64 AES key; blank disables credential retrieval.
CREDENTIAL_KEY=
BOOTSTRAP_STATION=
BOOTSTRAP_NAME=
BOOTSTRAP_CODE=
BOOTSTRAP_PASSWORD=
# ISOLATED databases only; never production
TEST_ADMIN_DATABASE_URL=
QA_STATION=
QA_PASSWORD=
CHROMIUM_PATH=

# Set true only after verifying metadata is outside Data API; never a secret.
FUELPULSE_PRIVATE_METADATA_CONFIRMED=false
# Disposable LOCAL cluster only; suite creates/drops uniquely named databases.
MIGRATION_TEST_DATABASE_URL=
MIGRATION_TEST_ALLOW_DATABASE_CREATION=false
