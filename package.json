{
    "name": "fuelpulse",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
        "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
        "build": "tsc && vite build",
        "typecheck": "tsc",
        "lint": "eslint .",
        "test": "node --import tsx node_modules/vitest/vitest.mjs --run",
        "test:migrations": "node --import tsx scripts/test-migrations.ts"
    },
    "dependencies": {
        "@emotion/react": "^11.11.1",
        "@emotion/styled": "^11.11.0",
        "@fastify/cookie": "11.1.2",
        "@fastify/helmet": "13.1.1",
        "@fastify/rate-limit": "11.2.0",
        "@fastify/static": "10.1.3",
        "@mui/icons-material": "^5.14.0",
        "@mui/lab": "^5.0.0-alpha.61",
        "@mui/material": "^5.14.0",
        "@zxing/browser": "0.2.1",
        "fastify": "5.12.3",
        "framer-motion": "^13.2.0",
        "idb": "8.0.3",
        "pg": "8.23.0",
        "qrcode": "1.5.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-toastify": "^10.0.3",
        "tesseract.js": "7.0.0",
        "zod": "4.5.4",
        "zustand": "^4.4.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.0.0",
        "@types/qrcode": "^1.5.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "6.1.1",
        "eslint": "^9.39.0",
        "globals": "^16.0.0",
        "playwright": "^1.58.0",
        "prettier": "^3.0.0",
        "tsx": "4.23.13",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.2.2",
        "vitest": "^0.34.0"
    }
}
